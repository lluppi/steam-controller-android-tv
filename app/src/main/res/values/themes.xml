<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, deliberately NOT a DayNight parent: this is an Android TV UI with no
         light variant, and a DayNight parent resolves to the light scheme unless night mode
         happens to be on, which repaints every fallback (text, ripples, focus highlights)
         wrong. Every Material token the app touches is therefore stated explicitly. -->
    <style name="Theme.SteamController" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Accent -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_on_container</item>

        <!-- Secondary: Steam blue, used for the action-card icon badges. -->
        <item name="colorSecondary">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="colorSecondaryContainer">@color/surface_3</item>
        <item name="colorOnSecondaryContainer">@color/accent_on_container</item>

        <!-- Tertiary: mint, for "live" affordances. -->
        <item name="colorTertiary">@color/ok_on_container</item>
        <item name="colorOnTertiary">@color/accent_on</item>
        <item name="colorTertiaryContainer">@color/ok_container</item>
        <item name="colorOnTertiaryContainer">@color/ok_on_container</item>

        <!-- Error -->
        <item name="colorError">@color/error_on_container</item>
        <item name="colorOnError">@color/error_container</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/error_on_container</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/window_bg</item>
        <item name="colorOnSurface">@color/text_high</item>
        <item name="colorSurfaceVariant">@color/surface_3</item>
        <item name="colorOnSurfaceVariant">@color/text_mid</item>
        <item name="colorSurfaceContainerLowest">@color/window_bg</item>
        <item name="colorSurfaceContainerLow">@color/surface_1</item>
        <item name="colorSurfaceContainer">@color/surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_3</item>
        <item name="colorSurfaceContainerHighest">@color/surface_4</item>

        <!-- Outlines: 1dp hairlines on cards, and the base colour of every focus ring. -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Inverse: the snackbar/contrast pair. -->
        <item name="colorOnSurfaceInverse">@color/window_bg</item>
        <item name="colorSurfaceInverse">@color/text_high</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>

        <!-- Framework (non-Material) widgets read these instead of colorOnSurface. -->
        <item name="android:textColorPrimary">@color/text_high</item>
        <item name="android:textColorSecondary">@color/text_mid</item>
        <item name="android:textColorTertiary">@color/text_low</item>
    </style>
</resources>
