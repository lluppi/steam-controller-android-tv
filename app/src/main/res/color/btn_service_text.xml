<?xml version="1.0" encoding="utf-8"?>
<!-- Big Start/Stop button label. Flips dark on focus so it stays legible when the fill
     goes bright - otherwise white-on-cyan washes out at TV viewing distance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/accent_on" />
    <item android:state_pressed="true" android:color="@color/accent_on" />
    <item android:color="@color/accent_on_container" />
</selector>
