<?xml version="1.0" encoding="utf-8"?>
<!--
  CalibrationActivity - one layout for every form factor.

  Was three near-copies at 405 / 405 / 399 lines that between them used exactly one custom
  style. Every colour, text size, padding and corner radius was written out by hand per
  variant, which is why this screen drifted furthest from the rest of the app.

  Now: four cards on the shared tokens, one column on a handheld and a 2x2 grid on a wide
  screen (Calib.Columns, overridden in values-television/styles.xml). The columns are equal
  height; the cards inside them are not - sticks + rumble down one side, gyro + desktop down
  the other, which is roughly what they weigh.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/window_bg"
            app:menu="@menu/menu_calibration"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:navigationIconTint="?attr/colorPrimary"
            app:title="@string/calib_title"
            app:titleTextColor="?attr/colorPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/content_max_width"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_pad_h"
            android:paddingTop="@dimen/content_pad_top"
            android:paddingBottom="@dimen/content_pad_bottom">

            <LinearLayout style="@style/Calib.Columns">

                <!-- ── Sticks + rumble ───────────────────────────────────────────── -->
                <LinearLayout style="@style/Calib.Col.Left">

                    <com.google.android.material.card.MaterialCardView style="@style/Calib.Card">

                        <LinearLayout style="@style/Calib.GroupBody">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_marginBottom="@dimen/block_gap"
                                android:text="@string/calib_sticks_header" />

                            <TextView style="@style/Calib.Field" android:text="@string/calib_deadzone_label" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.slider.Slider
                                        android:id="@+id/sliderLeftDeadzone"
                                        style="@style/Calib.Slider"
                                        android:contentDescription="@string/calib_slider_left_deadzone_desc"
                                        android:stepSize="1"
                                        android:value="8"
                                        android:valueFrom="0"
                                        android:valueTo="40" />

                                    <TextView
                                        android:id="@+id/tvLeftDeadzone"
                                        style="@style/Calib.Value"
                                        android:layout_gravity="center_horizontal"
                                        android:text="8%"
                                        tools:ignore="HardcodedText" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/debug_axis_gap"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.slider.Slider
                                        android:id="@+id/sliderRightDeadzone"
                                        style="@style/Calib.Slider"
                                        android:contentDescription="@string/calib_slider_right_deadzone_desc"
                                        android:stepSize="1"
                                        android:value="8"
                                        android:valueFrom="0"
                                        android:valueTo="40" />

                                    <TextView
                                        android:id="@+id/tvRightDeadzone"
                                        style="@style/Calib.Value"
                                        android:layout_gravity="center_horizontal"
                                        android:text="8%"
                                        tools:ignore="HardcodedText" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Visualisation and its readout, one per stick. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/block_gap"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.steamcontroller.android.StickPadView
                                        android:id="@+id/padLeft"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/calib_pad_height" />

                                    <TextView
                                        android:id="@+id/tvLeftRaw"
                                        style="@style/Calib.Value"
                                        android:layout_marginTop="@dimen/debug_chip_gap"
                                        android:text="Raw X: 0\nRaw Y: 0"
                                        tools:ignore="HardcodedText" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchLeftInvertY"
                                        style="@style/Calib.Switch"
                                        android:layout_marginTop="@dimen/debug_chip_gap"
                                        android:text="@string/calib_invert_y" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/debug_axis_gap"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <com.steamcontroller.android.StickPadView
                                        android:id="@+id/padRight"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/calib_pad_height" />

                                    <TextView
                                        android:id="@+id/tvRightRaw"
                                        style="@style/Calib.Value"
                                        android:layout_marginTop="@dimen/debug_chip_gap"
                                        android:text="Raw X: 0\nRaw Y: 0"
                                        tools:ignore="HardcodedText" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchRightInvertY"
                                        style="@style/Calib.Switch"
                                        android:layout_marginTop="@dimen/debug_chip_gap"
                                        android:text="@string/calib_invert_y" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- The screen's primary action, so it wears the same primary-button
                                 style as Start/Stop: same height, same focus ring, same flip of
                                 fill and text colour when focused. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCalibrateAll"
                                style="@style/Calib.SecondaryButton"
                                android:layout_marginTop="@dimen/block_gap"
                                android:text="@string/calib_calibrate_all" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Rumble sits under the sticks so the two columns balance: sticks + rumble
                         against gyro + desktop. -->
                    <com.google.android.material.card.MaterialCardView style="@style/Calib.Card">

                        <LinearLayout style="@style/Calib.GroupBody">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_marginBottom="@dimen/block_gap"
                                android:text="@string/calib_rumble_header" />

                            <TextView style="@style/Calib.Field" android:text="@string/calib_test_intensity" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderRumbleIntensity"
                                style="@style/Calib.Slider"
                                android:contentDescription="@string/calib_slider_rumble_intensity_desc"
                                android:stepSize="5"
                                android:value="100"
                                android:valueFrom="0"
                                android:valueTo="100" />

                            <TextView
                                android:id="@+id/tvRumbleIntensity"
                                style="@style/Calib.Value"
                                android:layout_marginBottom="@dimen/block_gap"
                                android:text="100%"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTestRumble"
                                style="@style/Calib.SecondaryButton"
                                android:text="@string/calib_test_rumble" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── Gyro + desktop ───────────────────────────────────────────── -->
                <LinearLayout style="@style/Calib.Col.Right">

                    <!-- The margin has to be on the include tag: once an <include> specifies
                         layout_width/height, its layout params come from the tag, so the root
                         card's own marginBottom would be dropped. -->
                    <include
                        android:id="@+id/gyroControls"
                        layout="@layout/include_gyro_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/block_gap" />

                    <com.google.android.material.card.MaterialCardView style="@style/Calib.Card">

                        <LinearLayout style="@style/Calib.GroupBody">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_marginBottom="@dimen/block_gap"
                                android:text="@string/calib_desktop_header" />

                            <TextView style="@style/Calib.Field" android:text="@string/calib_mouse_sensitivity" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderMouseSensitivity"
                                style="@style/Calib.Slider"
                                android:contentDescription="@string/calib_mouse_sensitivity"
                                android:stepSize="0.1"
                                android:value="1.0"
                                android:valueFrom="0.1"
                                android:valueTo="3.0" />

                            <TextView
                                android:id="@+id/tvMouseSensitivity"
                                style="@style/Calib.Value"
                                android:layout_marginBottom="@dimen/block_gap"
                                android:text="1.0×"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchTrackpadAsMouse"
                                style="@style/Calib.Switch"
                                android:text="@string/calib_trackpad_switch_label" />

                            <TextView style="@style/Calib.Hint" android:text="@string/calib_trackpad_hint" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchStartOnBoot"
                                style="@style/Calib.Switch"
                                android:layout_marginTop="@dimen/block_gap"
                                android:text="@string/calib_start_on_boot" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchStartOnConnect"
                                style="@style/Calib.Switch"
                                android:layout_marginTop="@dimen/debug_chip_gap"
                                android:text="@string/calib_start_on_connect" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
