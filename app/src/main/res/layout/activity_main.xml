<?xml version="1.0" encoding="utf-8"?>
<!--
  MainActivity - one layout for every form factor.

  Phone and TV used to be two near-identical copies of this file, which is how the section
  labels drifted apart, the icon glyphs ended up off-centre and the Start/Stop focus state
  went unnoticed. Everything that differs between the two now lives in a named dimension
  (values/dimens.xml, values-television/dimens.xml) or in a style (values-television/styles.xml),
  so this file has no configuration-specific markup at all.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/content_pad_h"
        android:paddingTop="@dimen/content_pad_top"
        android:paddingBottom="@dimen/content_pad_bottom">

        <!-- ━━━━━━━━━━━━ Title row ━━━━━━━━━━━━ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/title_row_gap"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/subtitle_size" />
            </LinearLayout>

            <!-- A circle we control, not a MaterialButton: a single-icon button centres its
                 glyph with its own insets and padding, which is what put these off-centre. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnGithub"
                style="@style/CircleIconButton"
                android:contentDescription="@string/main_open_github_desc">

                <ImageView
                    style="@style/CircleIconButton.Glyph"
                    android:src="@drawable/ic_github"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHelp"
                style="@style/CircleIconButton"
                android:layout_marginStart="@dimen/icon_button_gap"
                android:contentDescription="@string/main_help_desc">

                <ImageView
                    style="@style/CircleIconButton.Glyph"
                    android:src="@drawable/ic_help"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ━━━━━━━━━━━━ Status pill ━━━━━━━━━━━━ -->
        <!-- Background and text colour are set from Kotlin: green while frames are actually
             arriving, amber otherwise. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusPillCard"
            style="@style/StatusPill"
            android:layout_marginTop="@dimen/block_gap">

            <TextView
                android:id="@+id/tvShizukuStatus"
                style="@style/StatusPill.Text"
                android:text="@string/main_shizuku_checking" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ━━━━━━━━━━━━ Controller + connection ━━━━━━━━━━━━
             Stacked on a handheld, side by side on TV - see Main.Pair in the two styles files. -->
        <!-- Orientation comes from Main.Pair - an inline android:orientation here would beat
             the style and pin this to one column on every form factor. -->
        <LinearLayout style="@style/Main.Pair">

            <!-- Hero: controller illustration and live status. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Main.HeroCard">

                <LinearLayout
                    style="@style/AppCard.Body"
                    android:padding="@dimen/hero_pad">

                    <TextView
                        android:id="@+id/tvControllerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/main_controller_disconnected"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="@dimen/hero_status_size"
                        android:textStyle="bold" />

                    <!-- Visibility is driven from Kotlin: an em dash where there is no reading
                         said nothing, so both of these are hidden until they have a value. -->
                    <TextView
                        android:id="@+id/tvBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/hero_meta_size"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hero_illus_height"
                        android:layout_marginTop="@dimen/row_gap"
                        android:layout_marginBottom="@dimen/row_gap"
                        android:contentDescription="@string/main_sc2026_illustration_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sc2026_controller_black"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/hero_meta_size"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Connection: transport and control mode, both under the same section label. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Main.ConnectionCard">

                <LinearLayout style="@style/AppCard.Body">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="@string/main_connection_label" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTransport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/label_gap"
                        android:layout_marginBottom="@dimen/block_gap"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTransportUsb"
                            style="@style/Segment"
                            android:text="@string/main_transport_usb"
                            app:icon="@drawable/ic_usb">
                            <requestFocus />
                        </com.google.android.material.button.MaterialButton>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTransportBt"
                            style="@style/Segment"
                            android:text="@string/main_transport_bt"
                            app:icon="@drawable/ic_bluetooth" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Same style as CONNECTION above - they used to be hand-written and
                         disagreed on colour, weight and letter spacing. -->
                    <TextView
                        style="@style/SectionLabel"
                        android:text="@string/main_control_mode_label" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleControlMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/label_gap"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeGamepad"
                            style="@style/Segment"
                            android:text="@string/main_mode_gamepad"
                            app:icon="@drawable/ic_gamepad" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeDesktop"
                            style="@style/Segment"
                            android:text="@string/main_mode_desktop"
                            app:icon="@drawable/ic_mouse" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ━━━━━━━━━━━━ Bluetooth device picker (visible only when transport=BT) ━━━━━━━━━━━━ -->
        <LinearLayout
            android:id="@+id/btDeviceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:gravity="top"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBtDevice"
                style="@style/BtField"
                android:hint="@string/main_bt_device_hint">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownBtDevice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="none"
                    android:nextFocusDown="@id/btnToggleService"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/segment_text_size"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRefreshBt"
                style="@style/BtRefresh"
                android:layout_marginStart="@dimen/bt_row_gap"
                android:layout_marginTop="@dimen/bt_refresh_nudge"
                android:contentDescription="@string/main_refresh_bt_desc"
                android:nextFocusDown="@id/btnToggleService">

                <ImageView
                    style="@style/CircleIconButton.Glyph"
                    android:src="@drawable/ic_refresh"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ━━━━━━━━━━━━ Start / Stop ━━━━━━━━━━━━ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleService"
            style="@style/BigActionButton"
            android:layout_marginTop="@dimen/block_gap"
            android:nextFocusDown="@id/btnCalibration"
            android:nextFocusUp="@id/btnRefreshBt"
            android:text="@string/btn_start" />

        <!-- ━━━━━━━━━━━━ Action cards ━━━━━━━━━━━━
             One row of four. Cards are equal height (match_parent height in a wrap_content row,
             which LinearLayout's uniform-height pass resolves), and each card's icon+label is
             centred as one group rather than pinned left. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCalibration"
                style="@style/ActionCard"
                android:layout_marginEnd="@dimen/action_grid_gap"
                android:nextFocusUp="@id/btnToggleService">

                <LinearLayout style="@style/ActionCard.Row">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ActionCard.Badge">

                        <ImageView
                            style="@style/ActionCard.Glyph"
                            android:src="@drawable/ic_calibration"
                            tools:ignore="ContentDescription" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/ActionCard.Label"
                        android:text="@string/main_action_calibration_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMapping"
                style="@style/ActionCard"
                android:layout_marginEnd="@dimen/action_grid_gap"
                android:nextFocusUp="@id/btnToggleService">

                <LinearLayout style="@style/ActionCard.Row">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ActionCard.Badge">

                        <ImageView
                            style="@style/ActionCard.Glyph"
                            android:src="@drawable/ic_mapping"
                            tools:ignore="ContentDescription" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/ActionCard.Label"
                        android:text="@string/main_action_mapping_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnGameProfiles"
                style="@style/ActionCard"
                android:layout_marginEnd="@dimen/action_grid_gap"
                android:nextFocusUp="@id/btnToggleService">

                <LinearLayout style="@style/ActionCard.Row">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ActionCard.Badge">

                        <ImageView
                            style="@style/ActionCard.Glyph"
                            android:src="@drawable/ic_game_profiles"
                            tools:ignore="ContentDescription" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/ActionCard.Label"
                        android:text="@string/main_action_profiles_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDebug"
                style="@style/ActionCard"
                android:nextFocusUp="@id/btnToggleService">

                <LinearLayout style="@style/ActionCard.Row">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ActionCard.Badge">

                        <ImageView
                            style="@style/ActionCard.Glyph"
                            android:src="@drawable/ic_debug"
                            tools:ignore="ContentDescription" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/ActionCard.Label"
                        android:text="@string/btn_debug" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Hidden log target - MainActivity.log() writes here for diagnostics. -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
