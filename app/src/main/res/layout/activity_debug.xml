<?xml version="1.0" encoding="utf-8"?>
<!--
  DebugActivity - one layout for every form factor.

  Was three near-copies, and they had drifted: the television version had silently lost the
  stick and trackpad bar graphs, which is why DebugActivity had to null-guard those binding
  fields. Both are here now, so the screen shows the same thing everywhere.

  Two columns on a wide screen, one on a narrow one (Debug.Columns, overridden in
  values-television/styles.xml). Cards on the shared radii, chips and axis bars on shared
  styles - no inline tints, no inline android:max, no hardcoded colours.

  Read-only screen: no focusable controls, so nothing needs <requestFocus/>.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/window_bg"
            app:menu="@menu/menu_debug"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:navigationIconTint="?attr/colorPrimary"
            app:title="@string/debug_title"
            app:titleTextColor="?attr/colorPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_pad_h"
            android:paddingTop="@dimen/content_pad_top"
            android:paddingBottom="@dimen/content_pad_bottom">

            <!-- Notice and report rate on one line, so the rate badge reads as part of the header
                 rather than floating on its own. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/block_gap"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/debug_readonly_notice"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/subtitle_size" />

                <TextView
                    android:id="@+id/tvReportRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/block_gap"
                    android:fontFamily="monospace"
                    android:text="0 Hz"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/subtitle_size"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout style="@style/Debug.Columns">

                <!-- ── Column 1: digital inputs ─────────────────────────────────── -->
                <LinearLayout style="@style/Debug.Col.Left">

                    <com.google.android.material.card.MaterialCardView style="@style/Debug.Group">

                        <LinearLayout style="@style/Debug.GroupBody">

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_face_buttons" />

                            <!-- Circular: these are the round buttons on the controller. -->
                            <LinearLayout style="@style/Debug.ChipRow">
                                <TextView android:id="@+id/btnA" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_a" />
                                <TextView android:id="@+id/btnB" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_b" />
                                <TextView android:id="@+id/btnX" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_x" />
                                <TextView android:id="@+id/btnY" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_y" />
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:layout_marginTop="@dimen/debug_section_gap"
                                android:text="@string/debug_bumpers_system" />

                            <LinearLayout style="@style/Debug.ChipRow">
                                <TextView android:id="@+id/btnLB" style="@style/Debug.Chip" android:text="@string/debug_btn_lb" />
                                <TextView android:id="@+id/btnRB" style="@style/Debug.Chip" android:text="@string/debug_btn_rb" />
                                <TextView android:id="@+id/btnSelect" style="@style/Debug.Chip" android:text="@string/debug_btn_select" />
                                <TextView android:id="@+id/btnSteam" style="@style/Debug.Chip" android:text="@string/debug_btn_steam_alt_glyph" />
                                <TextView android:id="@+id/btnStart" style="@style/Debug.Chip" android:text="@string/debug_btn_start_text" />
                                <TextView android:id="@+id/btnQA" style="@style/Debug.Chip" android:text="@string/debug_btn_qa" />
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:layout_marginTop="@dimen/debug_section_gap"
                                android:text="@string/debug_dpad" />

                            <LinearLayout style="@style/Debug.ChipRow">
                                <TextView android:id="@+id/btnDU" style="@style/Debug.ChipCircle" android:text="@string/debug_dpad_up" />
                                <TextView android:id="@+id/btnDD" style="@style/Debug.ChipCircle" android:text="@string/debug_dpad_down" />
                                <TextView android:id="@+id/btnDL" style="@style/Debug.ChipCircle" android:text="@string/debug_dpad_left" />
                                <TextView android:id="@+id/btnDR" style="@style/Debug.ChipCircle" android:text="@string/debug_dpad_right" />
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:layout_marginTop="@dimen/debug_section_gap"
                                android:text="@string/debug_sticks_pads_compact" />

                            <LinearLayout style="@style/Debug.ChipRow">
                                <TextView android:id="@+id/btnLS" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_l3" />
                                <TextView android:id="@+id/btnRS" style="@style/Debug.ChipCircle" android:text="@string/debug_btn_r3" />
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:layout_marginTop="@dimen/debug_section_gap"
                                android:text="@string/debug_grips_back" />

                            <LinearLayout style="@style/Debug.ChipRow">
                                <TextView android:id="@+id/btnLGrip" style="@style/Debug.Chip" android:text="@string/debug_btn_lgrip" />
                                <TextView android:id="@+id/btnRGrip" style="@style/Debug.Chip" android:text="@string/debug_btn_rgrip" />
                                <TextView android:id="@+id/btnL4" style="@style/Debug.Chip" android:text="@string/debug_btn_l4" />
                                <TextView android:id="@+id/btnL5" style="@style/Debug.Chip" android:text="@string/debug_btn_l5" />
                                <TextView android:id="@+id/btnR4" style="@style/Debug.Chip" android:text="@string/debug_btn_r4" />
                                <TextView android:id="@+id/btnR5" style="@style/Debug.Chip" android:text="@string/debug_btn_r5" />
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:layout_marginTop="@dimen/debug_section_gap"
                                android:text="@string/debug_triggers_header" />

                            <!-- Triggers are 0..255 after the /128 in DebugActivity, hence AxisBar
                                 rather than SignedAxisBar. -->
                            <LinearLayout style="@style/Debug.AxisPair">

                                <LinearLayout style="@style/Debug.AxisCol" android:paddingEnd="@dimen/debug_axis_gap">
                                    <TextView style="@style/AxisLabel" android:text="@string/debug_lt" />
                                    <ProgressBar android:id="@+id/pbLT" style="@style/AxisBar" />
                                    <TextView android:id="@+id/tvLT" style="@style/AxisVal" android:text="0" tools:ignore="HardcodedText" />
                                </LinearLayout>

                                <LinearLayout style="@style/Debug.AxisCol">
                                    <TextView style="@style/AxisLabel" android:text="@string/debug_rt" />
                                    <ProgressBar android:id="@+id/pbRT" style="@style/AxisBar" />
                                    <TextView android:id="@+id/tvRT" style="@style/AxisVal" android:text="0" tools:ignore="HardcodedText" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── Column 2: axes and the raw dump ─────────────────────────── -->
                <LinearLayout style="@style/Debug.Col.Right">

                    <com.google.android.material.card.MaterialCardView style="@style/Debug.Group">

                        <LinearLayout style="@style/Debug.GroupBody">

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_left_stick" />

                            <LinearLayout style="@style/Debug.AxisPair">

                                <LinearLayout style="@style/Debug.AxisCol" android:paddingEnd="@dimen/debug_axis_gap">
                                    <TextView android:id="@+id/tvLSX" style="@style/Debug.AxisValue" android:text="X:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbLSX" style="@style/SignedAxisBar" />
                                </LinearLayout>

                                <LinearLayout style="@style/Debug.AxisCol">
                                    <TextView android:id="@+id/tvLSY" style="@style/Debug.AxisValue" android:text="Y:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbLSY" style="@style/SignedAxisBar" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_right_stick" />

                            <LinearLayout style="@style/Debug.AxisPair">

                                <LinearLayout style="@style/Debug.AxisCol" android:paddingEnd="@dimen/debug_axis_gap">
                                    <TextView android:id="@+id/tvRSX" style="@style/Debug.AxisValue" android:text="X:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbRSX" style="@style/SignedAxisBar" />
                                </LinearLayout>

                                <LinearLayout style="@style/Debug.AxisCol">
                                    <TextView android:id="@+id/tvRSY" style="@style/Debug.AxisValue" android:text="Y:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbRSY" style="@style/SignedAxisBar" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_left_trackpad" />

                            <LinearLayout style="@style/Debug.AxisPair">

                                <LinearLayout style="@style/Debug.AxisCol" android:paddingEnd="@dimen/debug_axis_gap">
                                    <TextView android:id="@+id/tvLPX" style="@style/Debug.AxisValue" android:text="X:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbLPX" style="@style/SignedAxisBar" />
                                </LinearLayout>

                                <LinearLayout style="@style/Debug.AxisCol">
                                    <TextView android:id="@+id/tvLPY" style="@style/Debug.AxisValue" android:text="Y:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbLPY" style="@style/SignedAxisBar" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_right_trackpad" />

                            <LinearLayout style="@style/Debug.AxisPair">

                                <LinearLayout style="@style/Debug.AxisCol" android:paddingEnd="@dimen/debug_axis_gap">
                                    <TextView android:id="@+id/tvRPX" style="@style/Debug.AxisValue" android:text="X:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbRPX" style="@style/SignedAxisBar" />
                                </LinearLayout>

                                <LinearLayout style="@style/Debug.AxisCol">
                                    <TextView android:id="@+id/tvRPY" style="@style/Debug.AxisValue" android:text="Y:     0" tools:ignore="HardcodedText" />
                                    <ProgressBar android:id="@+id/pbRPY" style="@style/SignedAxisBar" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_imu_quaternion" />

                            <!-- Four across: AxisValFull is the 0dp+weight=1 variant, which is
                                 what a row of equal columns needs. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView android:id="@+id/tvQW" style="@style/AxisValFull" android:text="qW:    0" tools:ignore="HardcodedText" />
                                <TextView android:id="@+id/tvQX" style="@style/AxisValFull" android:text="qX:    0" tools:ignore="HardcodedText" />
                                <TextView android:id="@+id/tvQY" style="@style/AxisValFull" android:text="qY:    0" tools:ignore="HardcodedText" />
                                <TextView android:id="@+id/tvQZ" style="@style/AxisValFull" android:text="qZ:    0" tools:ignore="HardcodedText" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView style="@style/Debug.Group">

                        <LinearLayout style="@style/Debug.GroupBody">

                            <TextView
                                style="@style/DebugSectionTitle"
                                android:text="@string/debug_raw_report" />

                            <TextView
                                android:id="@+id/tvRawHex"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/debug_chip_gap"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="2dp"
                                android:text="-"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
