<?xml version="1.0" encoding="utf-8"?>
<!--
  Gyro controls, included by CalibrationActivity.

  Same card, radii and type ramp as the cards around it - it used to be a 20dp-cornered card
  with its own header styling and every value label set to 14sp, next to neighbours at 18dp
  and 12sp. Its layout_width/height come from the <include> tag at the call site.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/block_gap"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout style="@style/Calib.GroupBody">

        <TextView
            style="@style/SectionLabel"
            android:layout_marginBottom="@dimen/block_gap"
            android:text="@string/calib_gyro_header" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGyroEnabled"
            style="@style/Calib.Switch"
            android:text="@string/calib_gyro_enable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGyroActivation"
            style="@style/Calib.SecondaryButton"
            android:layout_marginTop="@dimen/block_gap"
            android:text="@string/calib_gyro_activation" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGyroSensitivity"
            style="@style/Calib.Slider"
            android:layout_marginTop="@dimen/debug_chip_gap"
            android:contentDescription="@string/calib_gyro_sensitivity"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="0.1"
            android:valueTo="3.0" />

        <TextView
            android:id="@+id/tvGyroSensitivity"
            style="@style/Calib.Value"
            android:text="1.0×"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGyroSensitivityY"
            style="@style/Calib.Slider"
            android:contentDescription="@string/calib_gyro_sensitivity_y"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="0.1"
            android:valueTo="3.0" />

        <TextView
            android:id="@+id/tvGyroSensitivityY"
            style="@style/Calib.Value"
            android:text="1.0× vertical"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGyroSmoothing"
            style="@style/Calib.Slider"
            android:contentDescription="@string/calib_gyro_smoothing"
            android:stepSize="0.05"
            android:value="0.25"
            android:valueFrom="0.0"
            android:valueTo="0.9" />

        <TextView
            android:id="@+id/tvGyroSmoothing"
            style="@style/Calib.Value"
            android:text="25% smoothing"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGyroDeadzone"
            style="@style/Calib.Slider"
            android:contentDescription="@string/calib_gyro_deadzone"
            android:stepSize="0.005"
            android:value="0.02"
            android:valueFrom="0.0"
            android:valueTo="0.1" />

        <TextView
            android:id="@+id/tvGyroDeadzone"
            style="@style/Calib.Value"
            android:text="0.020 rad/s deadzone"
            tools:ignore="HardcodedText" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGyroResponse"
            style="@style/Calib.Slider"
            android:contentDescription="@string/calib_gyro_response"
            android:stepSize="0.1"
            android:value="1.0"
            android:valueFrom="1.0"
            android:valueTo="2.0" />

        <TextView
            android:id="@+id/tvGyroResponse"
            style="@style/Calib.Value"
            android:text="1.0 response"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGyroCalibrate"
            style="@style/Calib.SecondaryButton"
            android:layout_marginTop="@dimen/block_gap"
            android:text="@string/calib_gyro_calibrate" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGyroInvertY"
            style="@style/Calib.Switch"
            android:layout_marginTop="@dimen/debug_chip_gap"
            android:text="@string/calib_gyro_invert_y" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
