<?xml version="1.0" encoding="utf-8"?>
<!-- Row background for the mapping list. Was ?attr/selectableItemBackground, which draws a
     rectangular highlight with sharp corners - visible the moment a row takes focus or a press.
     Same states, rounded, on the shared accent so focus reads the same as everywhere else. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_radius" />
            <solid android:color="@color/accent_container" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_radius" />
            <solid android:color="@color/surface_4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
